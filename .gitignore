venv/
__pycache__/
*.py[cod]

# CMake build output (~23 MB), from:
#   cmake -S . -B build -DCMAKE_PREFIX_PATH=/usr && cmake --build build
# In the tree is fine. If the sync churn of rebuilding inside a synced folder
# bothers you, exclude build/ from the client or build somewhere else — nothing
# in the build cares where it lives.
build/

# the WebAssembly build, from qt-cmake -B build-wasm (see CMakeLists.txt)
build-wasm/

# the Android build, from scripts/build-android.sh. Holds the Gradle project
# androiddeployqt generates and a copy of cards.db staged as an app asset.
build-android/

# the assembled site, from scripts/build-site.sh — web/ plus a copy of the
# wasm build, so everything in it is generated
site/

# generated by scripts/ingest.py (~29 MB, rebuild with: python3 scripts/ingest.py)
data/cards.db
# your own lists and decks — created on first run
data/decks.db

# tools/ downloads set symbols here on the way to building the glyph font
tools/.set-svg-cache/

# aqtinstall drops this wherever it is run from
aqtinstall.log

# scripts/fetch-android-openssl.sh downloads the OpenSSL the .apk has to carry
# (~4.6 MB of prebuilt .so, pinned and hash-checked there, not ours to track)
third_party/
