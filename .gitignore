venv/
__pycache__/
*.py[cod]

# CMake build output (~23 MB), from:
#   cmake -S . -B build -DCMAKE_PREFIX_PATH=/usr && cmake --build build
# In the tree is fine. If the sync churn of rebuilding inside a synced folder
# bothers you, exclude build/ from the client or build somewhere else — nothing
# in the build cares where it lives.
build/

# the WebAssembly build, from qt-cmake -B build-wasm (see CMakeLists.txt)
build-wasm/

# generated by scripts/ingest.py (~29 MB, rebuild with: python3 scripts/ingest.py)
data/cards.db
# your own lists and decks — created on first run
data/decks.db

# tools/ downloads set symbols here on the way to building the glyph font
tools/.set-svg-cache/
