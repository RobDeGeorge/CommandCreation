venv/
__pycache__/
*.py[cod]

# CMake build output. Build outside this tree — the executable `mtgdeck` and the
# QML module directory `MtgDeck` differ only by case, which Dropbox syncs as a
# conflict:
#   cmake -S . -B ~/.cache/mtgdeck-build && cmake --build ~/.cache/mtgdeck-build
build/

# generated by scripts/ingest.py (~29 MB, rebuild with: python3 scripts/ingest.py)
data/cards.db
# your own lists and decks — created on first run
data/decks.db

# tools/ downloads set symbols here on the way to building the glyph font
tools/.set-svg-cache/
